# ─── Site ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dami.example
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Phase 2 · Shopify Storefront API ──────────────────────────────
# When both are set, the catalogue, product pages and checkout use Shopify.
# When empty, the site uses content/catalog.json (preview mode, no checkout).
SHOPIFY_STORE_DOMAIN=            # e.g. dami-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN= # public Storefront API token
SHOPIFY_API_VERSION=2025-10

# ─── Early access / newsletter ─────────────────────────────────────
# Choose one provider. Without one, the form reports that sign-up is not yet open
# (no address is stored or faked).
NEWSLETTER_PROVIDER=             # klaviyo | mailchimp | shopify
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=         # e.g. us21
MAILCHIMP_AUDIENCE_ID=

# ─── Instagram (optional feed) ─────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=          # Instagram Graph API long-lived token
